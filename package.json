{
  "name": "st-martha-parent-companion",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run calendar:generate && vinext build && node scripts/prepare-pages.mjs",
    "calendar:generate": "node scripts/generate-calendar-ics.mjs",
    "sync:google": "node scripts/sync-google-content.mjs && node scripts/sync-google-calendar.mjs",
    "sync:staff": "node scripts/sync-school-staff.mjs",
    "start": "vite preview --outDir dist/client",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "tsx --test tests/newsletters.test.ts tests/unified-search.test.ts && node --test tests/google-calendar-sync.test.mjs tests/google-apps-script.test.mjs tests/lunch-menu-sync.test.mjs tests/newsletter-events.test.mjs tests/smore-newsletter-sync.test.mjs tests/staff-sync.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tesseract.js-data/eng": "^1.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tesseract.js": "^7.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13"
  },
  "type": "module"
}
